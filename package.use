# pass -c copies the secret to the clipboard; wayland pulls wl-clipboard so it
# uses wl-copy, X would pull xclip which is useless on a Wayland desktop
app-admin/pass wayland -X
# DDC/CI monitor brightness from the shell, udev rule and i2c group only
app-misc/ddcutil user-permissions -dbus -usb-monitor -X
# AirPlay mirroring under sway, no X11 and no vaapi on the arm boards.
# uxplay renders through GStreamer's autovideosink, which needs waylandsink
# from gst-plugins-bad and the wayland GL path in gst-plugins-base
media-video/uxplay -vaapi -X
media-libs/gst-plugins-base wayland egl gles2 -X
media-libs/gst-plugins-bad wayland -X
# Spotify Connect through pipewire-pulse like the other audio clients
media-sound/spotifyd pulseaudio -alsa
